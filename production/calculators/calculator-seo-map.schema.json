{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hulusi-tunc/alidemirbas-pro/production/calculators/calculator-seo-map.schema.json",
  "title": "CalculatorSeoMapRecord",
  "description": "Phase 3: one calculator's search-intent architecture. Structural shape only - cross-record checks (uniqueness, dead references, content slot validity) live in validate-calculator-seo.mjs, not here.",
  "type": "object",
  "required": [
    "calculatorId", "slug", "primaryKeyword", "primaryIntent", "secondaryKeywords",
    "contentDepth", "seoPriority", "titlePattern", "canonicalPath", "index",
    "localizationStatus", "cannibalizationRisks", "futureGlossary", "futureComparisons", "doNotTarget"
  ],
  "additionalProperties": false,
  "properties": {
    "calculatorId": { "type": "string", "pattern": "^CALC-[A-Z0-9-]+$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "primaryKeyword": { "type": "string", "minLength": 1 },
    "primaryIntent": { "const": "tool" },
    "secondaryKeywords": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["keyword", "intent", "placement"],
        "additionalProperties": false,
        "properties": {
          "keyword": { "type": "string", "minLength": 1 },
          "intent": {
            "type": "string",
            "enum": ["tool", "formula", "definition", "interpretation", "example", "benchmark", "comparison", "method-model", "improvement", "glossary-related-concept"]
          },
          "placement": {
            "type": "string",
            "enum": ["same-page", "supporting-section", "future-glossary", "future-comparison-page", "future-guide", "skip"]
          }
        }
      }
    },
    "contentDepth": { "type": "string", "enum": ["light", "standard", "deep"] },
    "seoPriority": { "type": "string", "enum": ["A", "B", "C", "D"] },
    "titlePattern": { "type": "string", "minLength": 1 },
    "canonicalPath": { "type": "string", "pattern": "^/calculators/[a-z0-9]+(-[a-z0-9]+)*$" },
    "index": { "type": "boolean" },
    "localizationStatus": {
      "type": "object",
      "required": ["name", "formulaPlainEnglish", "example", "metadata"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "formulaPlainEnglish": { "type": "string" },
        "example": { "type": "string" },
        "metadata": { "type": "string" }
      }
    },
    "cannibalizationRisks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["with", "why"],
        "additionalProperties": false,
        "properties": { "with": { "type": "string" }, "why": { "type": "string", "minLength": 1 } }
      }
    },
    "futureGlossary": { "type": "array", "items": { "type": "string" } },
    "futureComparisons": { "type": "array", "items": { "type": "string" } },
    "doNotTarget": { "type": "array", "items": { "type": "string" } }
  }
}
